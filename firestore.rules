rules_version = '2';

// Used by the local emulator and deployable to a real project with:
//   npx firebase deploy --only firestore:rules --project <project-id>
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // A user's own profile document (keyed by auth uid).
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Game sessions belong to the user in their `userId` field.
    match /game_sessions/{sessionId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Per-session data (linked to a session by `sessionId`).
    // Any signed-in user for now; tighten to session owners if needed.
    match /towns/{id}         { allow read, write: if signedIn(); }
    match /card_plays/{id}    { allow read, write: if signedIn(); }
    match /round_events/{id}  { allow read, write: if signedIn(); }
    match /round_stats/{id}   { allow read, write: if signedIn(); }

    // Optional shared game reference data (not currently written by the app).
    match /gameSettings/{id}  { allow read: if signedIn(); }
    match /townTemplates/{id} { allow read: if signedIn(); }
    match /cards/{id}         { allow read: if signedIn(); }
    match /hazards/{id}       { allow read: if signedIn(); }
  }
}
